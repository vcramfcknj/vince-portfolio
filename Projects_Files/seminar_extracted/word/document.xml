d="76D97E5D" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="10D1BDC9" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="596A6F35" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="63391E04" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="21417086" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="66867BD3" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="504941DE" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr></w:p><w:p w14:paraId="2570B0ED" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr></w:p><w:p w14:paraId="6F402E50" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20" w:rsidP="009B2A20"><w:pPr><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:t>2nd Semester, A.Y. 2025–2026</w:t></w:r></w:p><w:p w14:paraId="0C3DB870" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20"><w:pPr><w:spacing w:before="280" w:after="120"/><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr></w:pPr></w:p><w:p w14:paraId="36D96074" w14:textId="77777777" w:rsidR="00FC1D4F" w:rsidRDefault="00FC1D4F"><w:pPr><w:spacing w:before="280" w:after="120"/><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4C560BB8" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="009B2A20"><w:pPr><w:spacing w:before="280" w:after="120"/><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1C0C79EC" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:lastRenderedPageBreak/><w:t>I. INTRODUCTION</w:t></w:r></w:p><w:p w14:paraId="25AE11AD" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The BSIT Department of Ilocos Sur Polytechnic State College (ISPSC), Candon Campus conducted a three-day IT Seminar focused on Artificial Intelligence and Application Development from January 6 to 8, 2026. The activity was organized to expose students and faculty to the latest advancements in artificial intelligence, including generative AI, conversational AI, and agentic systems, as well as practical frameworks for building AI-powered applications.</w:t></w:r></w:p><w:p w14:paraId="21E8E381" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The seminar served as both an academic enrichment activity and a career development opportunity, aligning with the department's commitment to producing graduates equipped with relevant, industry-ready technology competencies. It featured a resource speaker from the private sector and was coordinated through the leadership of the BSIT Program Chair and a dedicated subject instructor.</w:t></w:r></w:p><w:p w14:paraId="7E6C948A" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="268B79AE" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:t>II. OBJECTIVES</w:t></w:r></w:p><w:p w14:paraId="4FC7D250" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The seminar aimed to achieve the following objectives:</w:t></w:r></w:p><w:p w14:paraId="3FDC398E" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>1. To introduce students and faculty to foundational and advanced concepts in Artificial Intelligence, including generative, conversational, and agentic AI.</w:t></w:r></w:p><w:p w14:paraId="7E98C50A" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>2. To expose participants to AI-powered application development methodologies, including PRD-driven and PRP-driven workflows.</w:t></w:r></w:p><w:p w14:paraId="45CC0346" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>3. To provide hands-on experience in building practical AI applications as part of team-based learning.</w:t></w:r></w:p><w:p w14:paraId="3EA66AF9" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>4. To connect participants with industry practitioners and thought leaders in the technology sector.</w:t></w:r></w:p><w:p w14:paraId="1162A46F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>5. To inspire students to integrate AI tools and platforms into their professional and academic work.</w:t></w:r></w:p><w:p w14:paraId="104ADEDD" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="23548207" w14:textId="77777777" w:rsidR="00FC1D4F" w:rsidRDefault="00FC1D4F"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="7C0D13CA" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:lastRenderedPageBreak/><w:t>III. PARTICIPANTS AND KEY PERSONNEL</w:t></w:r></w:p><w:p w14:paraId="1CBD3701" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The seminar was attended by students and faculty of the BSIT Department of ISPSC-Candon Campus. The event was organized under the supervision of the following key personnel:</w:t></w:r></w:p><w:p w14:paraId="21F3D657" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Program Chair, BSIT Department: Ariel A. Dela Cruz, MIT</w:t></w:r></w:p><w:p w14:paraId="22728B31" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Campus Director, ISPSC-Candon Campus: Annie D. Dorada, Ed.D.</w:t></w:r></w:p><w:p w14:paraId="1F52AA7F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Subject Instructor / Seminar Coordinator: Clariza G. Valdez, MIT</w:t></w:r></w:p><w:p w14:paraId="41639FDB" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Facilitator / Instructor: Fe Airam R. Dakig, MIT</w:t></w:r></w:p><w:p w14:paraId="25F8669B" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Resource Speaker: Emil Capino, CEO &amp; Founder, iAlchemy, Inc.</w:t></w:r></w:p><w:p w14:paraId="45851E2D" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="1EE38455" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Special messages were also delivered by distinguished guests from the private sector, namely: Francis Xavier Hernandez, Co-Founder &amp; Vice President of Audentes Technologies Inc.; Jeffrey Yu, CEO of High6 Corp; and Glo Anne DM Marfori, CEO of GMAC Business Developers, Inc. Their presence underscored the strong industry support and collaboration extended to the academic community.</w:t></w:r></w:p><w:p w14:paraId="19587E82" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="72F9FB98" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:t>IV. PROCEEDINGS</w:t></w:r></w:p><w:p w14:paraId="7B35E329" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="200" w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Day 1 – January 6, 2026: Opening Program and Introduction to Artificial Intelligence</w:t></w:r></w:p><w:p w14:paraId="5D58A04B" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The first day began at 7:45 AM with the assembly and gathering of participants at the venue. The formal program commenced at 8:00 AM with an opening prayer and welcome remarks delivered by Ariel A. Dela Cruz, MIT, Program Chair of the BSIT Department.</w:t></w:r></w:p><w:p w14:paraId="2C0A3597" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">Messages were subsequently delivered by Annie D. Dorada, Ed.D., Campus Director of ISPSC-Candon Campus; Francis Xavier Hernandez, Co-Founder and Vice President of Audentes Technologies Inc.; Jeffrey Yu, CEO of High6 Corp; and Glo Anne DM Marfori, CEO of GMAC Business Developers, Inc. These messages highlighted the significance </w:t></w:r><w:r><w:lastRenderedPageBreak/><w:t>of AI literacy in the contemporary workplace and encouraged the participants to embrace innovation and continuous learning.</w:t></w:r></w:p><w:p w14:paraId="1EB69B41" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Following a morning snack break, Clariza G. Valdez, MIT, presented the rationale and purpose of the IT Seminar, after which Fe Airam R. Dakig, MIT, introduced the resource speaker. The seminar proper commenced at 10:00 AM, led by Emil Capino, CEO and Founder of iAlchemy, Inc.</w:t></w:r></w:p><w:p w14:paraId="5E6EC555" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The morning session centered on an Introduction to Artificial Intelligence, providing participants with a comprehensive overview of AI principles and their real-world applications. After a lunch break at 12:00 noon, the afternoon sessions resumed at 1:00 PM with discussions on Generative AI and Conversational AI — two of the most transformative subfields in modern artificial intelligence. Following a short snack break at 2:45 PM, the session on Agentic AI was conducted at 3:00 PM, exploring autonomous AI systems capable of goal-directed behavior. The first day concluded at 5:00 PM.</w:t></w:r></w:p><w:p w14:paraId="5A953AF9" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="2A044E48" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="200" w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Day 2 – January 7, 2026: AI-Powered Application Development</w:t></w:r></w:p><w:p w14:paraId="023BE23F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The second day commenced at 8:00 AM under the continued facilitation of Emil Capino. The morning opened with a session on AI-Powered Application Development, equipping participants with conceptual and practical knowledge on how artificial intelligence can be integrated into software systems. This was followed by a session on PRD-Driven Development Workflow — a methodology that leverages product requirement documents to streamline AI application development processes.</w:t></w:r></w:p><w:p w14:paraId="4E63464E" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>After the noon break, afternoon sessions at 1:00 PM featured the PRP-Driven Context Engineering Workflow, introducing participants to a structured approach for managing context and prompts in AI-driven development. The day's final session covered AI Tools and Platforms for Application Development, where participants were introduced to widely used tools and frameworks in the AI industry. The second day ended at 5:00 PM.</w:t></w:r></w:p><w:p w14:paraId="518CF9C0" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00400B76"><w:pPr><w:spacing w:after="80"/></w:pPr></w:p><w:p w14:paraId="28561C4F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="200" w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Day 3 – January 8, 2026: Hands-On Application and Awarding</w:t></w:r></w:p><w:p w14:paraId="0A88C936" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The culminating day of the seminar began at 8:00 AM and was dedicated to hands-on, team-based activities. Participants worked in groups to build practical AI-powered applications, applying the skills and knowledge they had acquired over the preceding two days. The collaborative exercise allowed teams to demonstrate creativity, problem-solving, and technical competence in a real-world development context.</w:t></w:r></w:p><w:p w14:paraId="3C9BCD2C" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Following a noon break, teams presented their outputs from 1:00 PM to 3:00 PM, with each group showcasing their developed applications before the facilitators and fellow participants. The presentations highlighted the practical potential of AI in everyday applications and affirmed the participants' capacity to innovate within a short development cycle.</w:t></w:r></w:p><w:p w14:paraId="401ADF6F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The event concluded from 3:00 PM to 5:00 PM with the Awarding of Certificates and Closing Ceremony, recognizing the participation and accomplishments of all attendees. The closing rites marked a successful conclusion to the three-day learning event.</w:t></w:r></w:p><w:p w14:paraId="61FA85FB" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:t>V. SUMMARY AND OBSERVATIONS</w:t></w:r></w:p><w:p w14:paraId="62F2D429" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The three-day IT Seminar on Artificial Intelligence and Application Development was a resounding success in terms of content depth, participant engagement, and practical outcomes. The program was logistically well-structured, transitioning seamlessly from theoretical foundations on Day 1 to development methodologies on Day 2 and culminating in applied, team-based work on Day 3.</w:t></w:r></w:p><w:p w14:paraId="18C20AE7" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000" w:rsidP="00FC1D4F"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The resource speaker, Mr. Emil Capino, delivered highly relevant and industry-grounded content that resonated with both students and faculty. The participation of industry leaders as message senders further elevated the seminar's significance and bridged the gap between academic learning and professional practice.</w:t></w:r></w:p><w:p w14:paraId="672909DF" w14:textId="77777777" w:rsidR="009B2A20" w:rsidRDefault="00000000" w:rsidP="000C52F2"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Participants demonstrated enthusiasm and active engagement throughout all sessions. The team-based output presentations on the final day were particularly noteworthy, as they showcased the participants' ability to translate new knowledge into tangible, functional applications within a compressed timeframe.</w:t></w:r></w:p><w:p w14:paraId="2C6C9491" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:lastRenderedPageBreak/><w:t>VI. RECOMMENDATIONS</w:t></w:r></w:p><w:p w14:paraId="5C8C4F5F" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>Based on the outcomes of this seminar, the following recommendations are proposed:</w:t></w:r></w:p><w:p w14:paraId="0DCDE168" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>1. The BSIT Department may consider incorporating AI-related topics as a regular component of the curriculum, given the increasing relevance of AI in the technology industry.</w:t></w:r></w:p><w:p w14:paraId="2E4D09DB" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>2. Future seminars may allot more time for hands-on activities and mentorship from industry practitioners to further strengthen participants' applied skills.</w:t></w:r></w:p><w:p w14:paraId="5C7FDD70" w14:textId="77777777" w:rsidR="00400B76" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>3. Collaboration with iAlchemy, Inc. and other industry partners may be sustained to provide continuing education opportunities for both students and faculty.</w:t></w:r></w:p><w:p w14:paraId="31207B21" w14:textId="48BA57E4" w:rsidR="00D30BB2" w:rsidRDefault="00000000" w:rsidP="002636C4"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>4. A follow-up activity or capstone showcase may be organized to allow participants to further develop and present the applications initiated during the seminar.</w:t></w:r></w:p><w:p w14:paraId="46207A3A" w14:textId="44AD2BB2" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:t>VII. FEATURED PROJECT: HR MANAGEMENT SYSTEM</w:t></w:r></w:p><w:p w14:paraId="66FDE9B8" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000" w:rsidP="00095FD4"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>As part of the hands-on application development activities on Day 3 of the seminar, one of the featured outputs developed by the participating team is an HR Management System — a web-based platform designed to streamline and digitize core human resource functions within an organization. Built using modern web technologies and incorporating AI-powered capabilities, the system demonstrates the practical application of the concepts and workflows discussed throughout the three-day seminar.</w:t></w:r></w:p><w:p w14:paraId="35FC3234" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="200" w:after="80"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>System Modules and Features</w:t></w:r></w:p><w:p w14:paraId="271EC01F" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>1. Login / Authentication</w:t></w:r></w:p><w:p w14:paraId="61BD26D2" w14:textId="301DBBC7" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The system features a clean, secure login interface where HR administrators and staff can sign in using their credentials. The authentication screen includes username and password fields with a show/hide password toggle, ensuring both usability and security. Access is role-based, with designated privileges for HR admins and other system users.</w:t></w:r></w:p><w:p w14:paraId="0BA719E0" w14:textId="70CF2CB6" w:rsidR="00BF3533" w:rsidRDefault="00BF3533" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="25F0F3BC" wp14:editId="6AC23859"><wp:extent cx="5943600" cy="2690495"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1911661310" name="Picture 4"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 1"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2690495"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="30874405" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>2. Employee Management</w:t></w:r></w:p><w:p w14:paraId="504945B6" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The Employee Management module serves as the central hub for managing all employee records. HR administrators can view, add, edit, and delete employee profiles. Each record displays key details including employee number, full name, position, department, employment type (Regular or Contractual), status (Active/Inactive), and date hired. The module also supports search, filtering by department and status, and options to export or print the employee list.</w:t></w:r></w:p><w:p w14:paraId="1D9EBC72" w14:textId="6981F90C" w:rsidR="00BF3533" w:rsidRDefault="00BF3533" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="179DF546" wp14:editId="1AE8A9AE"><wp:extent cx="5943600" cy="2715260"/><wp:effectExtent l="0" t="0" r="0" b="8890"/><wp:docPr id="2144804305" name="Picture 5"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 3"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2715260"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="0C78C7FE" w14:textId="77777777" w:rsidR="002636C4" w:rsidRDefault="002636C4"><w:pPr><w:spacing w:before="160" w:after="60"/><w:rPr><w:b/></w:rPr></w:pPr></w:p><w:p w14:paraId="2604456A" w14:textId="2FCAA716" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:lastRenderedPageBreak/><w:t>3. Onboarding</w:t></w:r></w:p><w:p w14:paraId="0CE7B560" w14:textId="0D8F4881" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">The Onboarding module automates the new hire integration process through a structured Standard Onboarding Checklist. Tasks are organized into three phases — Pre-Day One, Day One, and First Week — and are automatically assigned to each new employee upon hiring. The module tracks individual onboarding progress, displays task completion counts, and provides quick access to the employee’s checklist and profile. This feature ensures a consistent and organized </w:t></w:r><w:r w:rsidR="00BF3533"><w:rPr><w:noProof/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251658240" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="23AD37B0" wp14:editId="5C99FF6C"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="margin"><wp:align>right</wp:align></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>624840</wp:posOffset></wp:positionV><wp:extent cx="5943600" cy="2733040"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:wrapSquare wrapText="bothSides"/><wp:docPr id="1458599931" name="Picture 6"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 5"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2733040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:anchor></w:drawing></w:r><w:r><w:t>onboarding experience across all new hires.</w:t></w:r></w:p><w:p w14:paraId="5F64A2AF" w14:textId="6CDFDCCD" w:rsidR="00BF3533" w:rsidRDefault="00BF3533" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr></w:p><w:p w14:paraId="3025CA64" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>4. AI-Powered Assessment (AI Assess)</w:t></w:r></w:p><w:p w14:paraId="34D21FBE" w14:textId="2C4E1C66" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>One of the most distinctive features of the system is the AI Assess module, powered by Groq AI (Llama 3.1). This module leverages artificial intelligence to evaluate each employee’s onboarding progress, predict hire success, and generate actionable insights to guide HR decision-making. The module displays aggregate statistics such as the number of employees in onboarding, total assessments conducted, and pending assessments. AI assessment results are accessible per employee and help HR teams proactively identify and address potential onboarding concerns.</w:t></w:r></w:p><w:p w14:paraId="79D53477" w14:textId="0E343EB8" w:rsidR="00BF3533" w:rsidRDefault="002636C4" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="748DD11A" wp14:editId="3F3667BC"><wp:extent cx="5943600" cy="2703830"/><wp:effectExtent l="0" t="0" r="0" b="1270"/><wp:docPr id="2110298173" name="Picture 13"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 19"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2703830"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7C188573" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>5. Documents</w:t></w:r></w:p><w:p w14:paraId="53C48D47" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The Documents module provides a centralized repository for all employee-related files. Documents are categorized into four types — Contracts, Compliance, Personal, and Other — allowing HR staff to quickly locate and manage records. Users can upload files and click to download them directly from the system. The module supports both grid and list view modes for flexible document browsing.</w:t></w:r></w:p><w:p w14:paraId="67F3BF5D" w14:textId="0700B9AB" w:rsidR="00BF3533" w:rsidRDefault="00BF3533" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="6D6C1C62" wp14:editId="1D58DCDF"><wp:extent cx="5943600" cy="2698115"/><wp:effectExtent l="0" t="0" r="0" b="6985"/><wp:docPr id="1752210531" name="Picture 8"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 9"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId11" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2698115"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="366CCA6A" w14:textId="36B092A2" w:rsidR="00D30BB2" w:rsidRDefault="00BF3533"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:br/></w:r><w:r><w:rPr><w:b/></w:rPr><w:br/></w:r><w:r><w:rPr><w:b/></w:rPr><w:lastRenderedPageBreak/><w:br/><w:t>6. Audit Logs</w:t></w:r></w:p><w:p w14:paraId="069E1463" w14:textId="34749E1D" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The Audit Logs module provides a comprehensive trail of all system activities and data changes. Each log entry captures the date and time, the user who performed the action, the type of action (e.g., View, Create, Update, Delete), the affected database table, the record ID, and the IP address of the user. Administrators can filter logs by action type, table, and user for targeted auditing. This feature promotes transparency, data accountability, and system integrity.</w:t></w:r></w:p><w:p w14:paraId="24AF5292" w14:textId="53FD6717" w:rsidR="00BF3533" w:rsidRDefault="00BF3533" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="75E3A282" wp14:editId="0019107B"><wp:extent cx="5943600" cy="2720340"/><wp:effectExtent l="0" t="0" r="0" b="3810"/><wp:docPr id="771755330" name="Picture 10"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 13"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId12" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2720340"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7980BF33" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="60"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>7. Help &amp; Support</w:t></w:r></w:p><w:p w14:paraId="5B34124B" w14:textId="13AAC2A2" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:ind w:left="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The Help &amp; Support module offers in-system guidance for all types of users. It features a searchable knowledge base, quick-access cards for Getting Started, FAQs, Contact Support, and Video Tutorials, as well as organized help content segmented for HR Administrators, Managers, and Employees. This ensures that users at all levels can efficiently resolve questions and maximize their use of the system without requiring external assistance.</w:t></w:r></w:p><w:p w14:paraId="35832598" w14:textId="7AA3AB20" w:rsidR="00BF3533" w:rsidRDefault="002636C4" w:rsidP="00BF3533"><w:pPr><w:spacing w:after="120" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="60F379FE" wp14:editId="612ABA35"><wp:extent cx="5943600" cy="2710180"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1205873123" name="Picture 12"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 17"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId13" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2710180"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="77AEB05E" w14:textId="77777777" w:rsidR="00D30BB2" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="160" w:after="160" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The HR Management System stands as a testament to the participants’ capacity to develop functional, AI-integrated software solutions within a structured and time-bound environment. It effectively embodies the seminar’s core themes of AI-powered application development, PRD- and PRP-driven workflows, and the use of modern AI tools and platforms.</w:t></w:r></w:p><w:p w14:paraId="109D1C50" w14:textId="77777777" w:rsidR="002636C4" w:rsidRDefault="002636C4" w:rsidP="002636C4"><w:pPr><w:spacing w:before="280" w:after="120"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="26"/><w:szCs w:val="26"/><w:u w:val="single"/></w:rPr><w:t>VII. CONCLUSION</w:t></w:r></w:p><w:p w14:paraId="7653F603" w14:textId="77777777" w:rsidR="002636C4" w:rsidRDefault="002636C4" w:rsidP="002636C4"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The IT Seminar on Artificial Intelligence and Application Development held on January 6 to 8, 2026, at ISPSC-Candon Campus was a meaningful and impactful academic endeavor. It successfully fulfilled its objectives of equipping participants with knowledge and practical skills in artificial intelligence and modern application development practices.</w:t></w:r></w:p><w:p w14:paraId="0E11BFD6" w14:textId="77777777" w:rsidR="002636C4" w:rsidRDefault="002636C4" w:rsidP="002636C4"><w:pPr><w:spacing w:after="160" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="720"/><w:jc w:val="both"/></w:pPr><w:r><w:t>The event affirmed the BSIT Department's commitment to academic excellence and industry relevance, and demonstrated the power of collaboration between educational institutions and the private sector. The BSIT Department expresses its sincere gratitude to all speakers, guests, organizers, and participants who contributed to the success of this activity.</w:t></w:r></w:p><w:p w14:paraId="02E00337" w14:textId="36E2D977" w:rsidR="00D30BB2" w:rsidRDefault="00D30BB2"><w:pPr><w:spacing w:after="40"/></w:pPr></w:p><w:sectPr w:rsidR="00D30BB2"><w:headerReference w:type="default" r:id="rId14"/><w:footerReference w:type="default" r:id="rId15"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>